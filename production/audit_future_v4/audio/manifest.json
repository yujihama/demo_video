      "rate_deviation_pct": -10.6
    },
    {
      "id": "06",
      "slot": "P3",
      "text": "分析や資料の探索はAIが自律的に進め、結果は手元でも確認できます。",
      "duration_seconds": 6.06,
      "chars": 31,
      "chars_per_second": 5.12,
      "fits": true,
      "rate_deviation_pct": -14.3
    },
    {
      "id": "07",
      "slot": "S5",
      "text": "受領した資料を投入すると、同業比較や経営指標も踏まえて示唆が更新されます。",
      "duration_seconds": 6.06,
      "chars": 35,
