      "rate_deviation_pct": -5.6
    },
    {
      "id": "02",
      "slot": "S2",
      "text": "大量の不正事例を学習した機械学習モデルがスコアを算出し、AIがその根拠を説明します。",
      "duration_seconds": 6.9,
      "chars": 40,
