      "chars_per_second": 6.03,
      "fits": true,
      "rate_deviation_pct": 1.0
    },
    {
      "id": "04",
      "slot": "S3",
      "text": "AIは、スコアの根拠に関連する箇所を、投入された資料から探してハイライトすることもできます。",
      "duration_seconds": 6.08,
      "chars": 43,
